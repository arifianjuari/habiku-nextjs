# Supabase (wajib — client & server)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# URL aplikasi (disarankan untuk auth callback & undangan)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Web Push PWA (opsional — W4 engagement) — ⏳ ditunda
# Generate pasangan VAPID: npx web-push generate-vapid-keys
NEXT_PUBLIC_WEB_PUSH_VAPID_PUBLIC_KEY=
# Hanya server — jangan expose ke client
WEB_PUSH_VAPID_PRIVATE_KEY=

# Service role — hanya di Vercel/server, JANGAN di client
# SUPABASE_SERVICE_ROLE_KEY=

# Cron BigQuery (opsional)
# CRON_SECRET=

# Rahasia internal (server only) — cron & webhook push
CRON_SECRET=
TASK_PENDING_WEBHOOK_SECRET=
WEB_PUSH_VAPID_SUBJECT=mailto:habiku@vercel.app
